# Postgres. The local value matches docker-compose.yml.
DATABASE_URL=postgres://aabshar:aabshar_dev@127.0.0.1:55434/aabshar

# First admin account, created by `npm run db:seed`. Change the password after the first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Demo dealer sign-in button ("See the demo portal"). Set to 0 before launch.
DEMO_PORTAL=1
