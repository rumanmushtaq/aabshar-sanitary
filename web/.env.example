# Database: Neon Postgres, connected to the Vercel project. Fill these locally with `npm run env:pull`
# (writes .env.local). DATABASE_URL is the pooled connection, DATABASE_URL_UNPOOLED the direct one
# used by migrations and the seed script.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# First admin account, created by `npm run db:seed`. Only needed where the seed runs, not on Vercel.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Demo dealer sign-in button ("See the demo portal"). Set to 0 before launch.
DEMO_PORTAL=1
